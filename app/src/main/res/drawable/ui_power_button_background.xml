<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/ui_accent" />
            <stroke android:width="3dp" android:color="@color/ui_accent_bright" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="@color/ui_accent" />
            <stroke android:width="3dp" android:color="@color/ui_accent_bright" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/ui_surface_raised" />
            <stroke android:width="1dp" android:color="@color/ui_stroke" />
        </shape>
    </item>
</selector>
