<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/ui_accent_dim" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/ui_accent" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/ui_accent_dim" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/ui_accent" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/ui_surface" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/ui_stroke" />
        </shape>
    </item>
</selector>
